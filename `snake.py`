import pygame

# Constants for initial configuration
INITIAL_POSITION = (100, 100)
INITIAL_DIRECTION = (10, 0)
GROWTH_INCREMENT = 1

class Snake:
    def __init__(self):
        self.reset()

    def reset(self):
        self.body = [INITIAL_POSITION]  # Initial position of the Snake
        self.direction = INITIAL_DIRECTION   # Initial movement direction (moving right)
        self.length = 1            # Initial length of the Snake

    def move(self):
        # Move the Snake in the current direction
        new_head = (self.body[0][0] + self.direction[0], self.body[0][1] + self.direction[1])
        self.body.insert(0, new_head)  # Insert new head at the front
        if len(self.body) > self.length:
            self.body.pop()  # Remove the last segment if not growing

    def change_direction(self, new_direction):
        # Change the Snake's direction if it is not opposite to the current direction
        if (new_direction[0] * -1, new_direction[1] * -1) != self.direction:
            self.direction = new_direction

    def grow(self):
        # Increase the length of the Snake by 1
        self.length += GROWTH_INCREMENT

    def check_collision(self, boundary):
        # Check if the Snake hits walls or itself
        # Wall collision
        head_x, head_y = self.body[0]
        if head_x < 0 or head_y < 0 or head_x >= boundary[0] or head_y >= boundary[1]:
            return True  # Collision with walls
        # Self-collision
        if self.body[0] in self.body[1:]:
            return True  # Collision with itself
        return False
